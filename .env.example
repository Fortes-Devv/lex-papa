# Copie este arquivo para .env (dev) e configure as mesmas chaves como
# Environment Variables no dashboard da Vercel (produção).

# Neon Postgres — Dashboard > Connection Details
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/lms?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/lms?sslmode=require"

# Auth.js — gerar com: npx auth secret
AUTH_SECRET=""

# Cloudinary — Dashboard > Settings > Access Keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Mercado Pago — Painel de Desenvolvedores > Credenciais
MERCADOPAGO_ACCESS_TOKEN=""
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=""
MERCADOPAGO_WEBHOOK_SECRET=""

# Bunny Stream — Stream > (biblioteca) > API
BUNNY_STREAM_LIBRARY_ID=""
BUNNY_STREAM_API_KEY=""
BUNNY_STREAM_CDN_HOSTNAME="" # ex.: vz-xxxxxxxx-xxx.b-cdn.net
# Chave de "Token Authentication" da Pull Zone do Stream (assina as URLs dos vídeos).
# Configure aqui ANTES de ativar o token no painel do Bunny.
BUNNY_STREAM_TOKEN_KEY=""

# Efí — Pix e cartão de crédito (pagamentos novos). Com tudo preenchido, o checkout usa a Efí;
# sem, continua no Mercado Pago. Credenciais, certificado e identificador de conta: mesmo ambiente.
EFI_CLIENT_ID=""
EFI_CLIENT_SECRET=""
# O .p12 em base64, uma linha (PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("C:\caminho\producao.p12"))).
EFI_CERTIFICADO=""
# Chave aleatória SÓ da LEX (o aviso de Pix é por chave: não reaproveite a do plataforma-de-questoes).
EFI_CHAVE_PIX=""
# "true" em homologação; apague em produção.
EFI_SANDBOX=""
# Texto aleatório longo, só letras e números (vai na URL dos avisos).
EFI_WEBHOOK_SEGREDO=""
# Identificador de conta (API > Introdução). É público: vai para o navegador.
NEXT_PUBLIC_EFI_CONTA=""

# YouTube Data API v3 (só leitura de playlists) — Google Cloud > APIs > Credenciais.
YOUTUBE_API_KEY=""
# Senha da checagem diária das playlists (Vercel Cron manda "Bearer <CRON_SECRET>").
# Qualquer texto longo e aleatório; a Vercel usa sozinha quando a variável existe.
CRON_SECRET=""

# URL pública do site (usada nos links enviados por e-mail, ex.: redefinir senha).
# Sem barra no final. Ex.: https://lexcursos.site
APP_URL=""

# Resend — envio de e-mails
RESEND_API_KEY=""
EMAIL_FROM="LEX Concursos <nao-responda@lexcursos.site>"

# Seed (npm run db:seed) — cria/atualiza o primeiro admin. Não precisa ficar na Vercel.
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""
# ADMIN_NAME="Admin"
# ALLOW_PROD_SEED="1"   # só se rodar com NODE_ENV=production de propósito
